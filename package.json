{
  "name": "tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/start.cjs\"",
    "build": "vite build",
    "start": "node scripts/start.cjs --build",
    "postinstall": "node scripts/fetch-ublock.cjs",
    "fetch:ublock": "node scripts/fetch-ublock.cjs --force",
    "evs:setup": "python3 -m venv .venv-evs && .venv-evs/bin/python -m pip install --upgrade castlabs-evs",
    "evs:signup": ".venv-evs/bin/python -m castlabs_evs.account signup",
    "sign:vmp": ".venv-evs/bin/python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist"
  },
  "dependencies": {
    "electron-chrome-extensions": "^4.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
