{
  "name": "tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "postinstall": "node scripts/fetch-ublock.cjs",
    "fetch:ublock": "node scripts/fetch-ublock.cjs --force"
  },
  "dependencies": {
    "electron-chrome-extensions": "^4.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
